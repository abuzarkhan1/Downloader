# Example environment variables file - copy to .env.local for local development
# or set these directly in Vercel Dashboard for production.

# Backend API base URL
# - Local development: http://localhost:8000
# - Production (Cloudflare Tunnel): https://video.marenax.site
NEXT_PUBLIC_API_URL=https://video.marenax.site

# Set to 'true' to enable mock mode (no real backend needed, useful for UI dev)
NEXT_PUBLIC_USE_MOCK=false
